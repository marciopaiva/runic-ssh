FROM docker.io/library/alpine:latest

RUN apk add --no-cache openssh openssh-sftp-server \
 && adduser -D -s /bin/ash deploy \
 && echo 'deploy:runic-test' | chpasswd \
 && mkdir -p /home/deploy/logs /home/deploy/config \
 && echo 'hello from the test host' > /home/deploy/README \
 && head -c 200000 /dev/urandom | base64 > /home/deploy/logs/big.log \
 && chown -R deploy:deploy /home/deploy \
 && printf '%s\n' \
      'Port 2222' \
      'PasswordAuthentication yes' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'Subsystem sftp /usr/lib/ssh/sftp-server' \
      'PrintMotd no' \
      > /etc/ssh/sshd_config

# Host keys are generated at start, not baked in: a fresh container means a
# fresh key, which is exactly how the changed-host-key path gets tested.
RUN printf '%s\n' '#!/bin/sh' 'ssh-keygen -A >/dev/null 2>&1' 'exec /usr/sbin/sshd -D -e' > /start.sh \
 && chmod +x /start.sh

EXPOSE 2222
CMD ["/start.sh"]
