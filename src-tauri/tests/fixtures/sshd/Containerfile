FROM docker.io/library/alpine:latest

# One image, several roles. The jump fixture needs a bastion and a target whose
# credentials differ, because a chain that reuses one credential for both hops
# connects perfectly against a fixture where they are the same.
ARG USERNAME=deploy
ARG PASSWORD=runic-test
ARG ROLE="test host"

RUN apk add --no-cache openssh openssh-sftp-server \
 && adduser -D -s /bin/ash "$USERNAME" \
 && echo "$USERNAME:$PASSWORD" | chpasswd \
 && mkdir -p "/home/$USERNAME/logs" "/home/$USERNAME/config" \
 && echo "hello from the $ROLE" > "/home/$USERNAME/README" \
 && head -c 200000 /dev/urandom | base64 > "/home/$USERNAME/logs/big.log" \
 && chown -R "$USERNAME:$USERNAME" "/home/$USERNAME" \
 && printf '%s\n' \
      'Port 2222' \
      'PasswordAuthentication yes' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'Subsystem sftp /usr/lib/ssh/sftp-server' \
      'PrintMotd no' \
      > /etc/ssh/sshd_config

# Host keys are generated at start, not baked in: a fresh container means a
# fresh key, which is exactly how the changed-host-key path gets tested.
RUN printf '%s\n' '#!/bin/sh' 'ssh-keygen -A >/dev/null 2>&1' 'exec /usr/sbin/sshd -D -e' > /start.sh \
 && chmod +x /start.sh

EXPOSE 2222
CMD ["/start.sh"]
