{
  /* Build tooling and tests run under Node; the application does not. Keeping
     them in a separate project is what stops a component from importing
     `node:fs` and still typechecking, when at runtime it lives in a webview
     with no filesystem at all. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    /* DOM is here for tests that mount a hook into jsdom, not because a tool
       runs in a browser. The `node:fs` boundary this file exists for is about
       what the application can import, not what a test can reference. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["tests", "vite.config.ts"]
}
